# Shared topology + coordination settings used by node/admin scripts.

# Cluster topology source-of-truth (choose one strategy):
# 1) Explicit mapping
# NODES=A:8001,B:8002,C:8003,D:8004,E:8005,F:8006,G:8007
# 2) Generated mapping from size + base port
CLUSTER_SIZE=3
CLUSTER_BASE_PORT=8001

# Coordination
ZK_ADDR=localhost:2181
ZK_ROOT=/quorapay
