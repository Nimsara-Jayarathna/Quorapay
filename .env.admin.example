# Admin service runtime settings.

# Admin API
ADMIN_PORT=8090
ADMIN_API_TOKEN=dev-admin-token
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Script execution
ADMIN_SCRIPT_ROOT=.
RUN_NODE_SCRIPT=./scripts/run-node.sh
KILL_NODE_SCRIPT=./scripts/kill-node.sh

# Optional topology override for admin process (usually not needed if .env.common is set)
# NODES=A:8001,B:8002,C:8003,D:8004,E:8005,F:8006,G:8007
# CLUSTER_SIZE=7
# CLUSTER_BASE_PORT=8001
